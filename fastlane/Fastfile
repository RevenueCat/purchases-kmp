# This file contains the fastlane.tools configuration
# You can find the documentation at https://docs.fastlane.tools
#
# For a list of all available actions, check out
#
#     https://docs.fastlane.tools/actions
#
# For a list of all available plugins, check out
#
#     https://docs.fastlane.tools/plugins/available-plugins
#

REPO_NAME = "purchases-kmp"
PATH_CHANGELOG_LATEST = './CHANGELOG-LATEST.md'
PATH_CHANGELOG = './CHANGELOG.md'
PATH_VERSIONS = './VERSIONS.md'
FILES_WITH_SDK_VERSION = {
  './gradle/libs.versions.toml' => ["revenuecat-kmp = \"{x}\""]
}

desc "Bumps version, edits changelog, and creates pull request"
lane :bump do |options|
  bump_version_update_changelog_create_pr(
    current_version: current_version_number,
    changelog_latest_path: PATH_CHANGELOG_LATEST,
    changelog_path: PATH_CHANGELOG,
    files_to_update: FILES_WITH_SDK_VERSION,
    files_to_update_without_prerelease_modifiers: {},
    repo_name: REPO_NAME,
    github_rate_limit: options[:github_rate_limit],
    editor: options[:editor],
    next_version: options[:next_version],
    automatic_release: options[:automatic_release],
    versions_file_path: PATH_VERSIONS,
    is_prerelease: options[:is_prerelease]
  )
  update_versions_file(current_version_number)
  commit_current_changes(commit_message: 'Updates VERSIONS.md')
  push_to_git_remote(set_upstream: true)
end

desc "Automatically determines next version, bumps it, edits changelog, and creates pull request"
lane :automatic_bump do |options|
  next_version, type_of_bump = determine_next_version_using_labels(
    repo_name: REPO_NAME,
    github_rate_limit: options[:github_rate_limit]
  )
  options[:next_version] = next_version
  options[:automatic_release] = true
  if type_of_bump == :skip
    UI.message('Skipping automatic bump since the next version doesn\'t include public facing changes')
    next
  elsif type_of_bump == :major
    UI.message('Skipping automatic bump since the next version is a major release')
    next
  end
  bump(options)
end

desc "Opens a PR updating the SDK version to the next minor, appending -SNAPSHOT."
lane :prepare_next_snapshot_version do |options|
  create_next_snapshot_version(
    current_version: current_version_number,
    repo_name: REPO_NAME,
    github_pr_token: ENV["GITHUB_PULL_REQUEST_API_TOKEN"],
    files_to_update: FILES_WITH_SDK_VERSION
  )
end

desc "Tags the current branch with the current version number"
lane :tag_current_branch do |options|
  version_number = current_version_number
  check_no_git_tag_exists(version_number)

  add_git_tag(tag: version_number)
  push_git_tags(tag: version_number)
end

desc "Publish the SDK if the current version is a SNAPSHOT version"
lane :publish_if_snapshot do |options|
  version = current_version_number
  if version.end_with?("-SNAPSHOT")
    publish
  else
    UI.verbose("The current version '#{version}' is not a SNAPSHOT version, so nothing will be published.")
  end
end

desc "Publish the SDK if the current version is a release version"
lane :publish_if_release do |options|
  version = current_version_number
  if version.end_with?("-SNAPSHOT")
    UI.user_error!("The current version '#{version}' is a SNAPSHOT version.")
  else
    publish
  end
end

desc "Creates a GitHub release for the current version"
lane :github_release_current_version do |options|
  github_release(version: current_version_number)
end

desc "Creates a GitHub release"
lane :github_release do |options|
  create_github_release(
    version: options[:version],
    repo_name: REPO_NAME,
    github_api_token: ENV["GITHUB_TOKEN"],
    changelog_latest_path: PATH_CHANGELOG_LATEST,
    upload_assets: []
  )
end

desc "Build released and local KMP SDK update test apps"
lane :build_sdk_update_test_apps do |options|
  platform = sdk_update_test_platform(options)
  base_path = File.expand_path("..", Dir.pwd)
  output_dir = File.expand_path(options[:output_dir] || "build/sdk_update_tests/#{platform}", base_path)
  project_dir = "#{base_path}/e2e-tests/SDKUpdateTester"
  local_version = current_version_number
  release_version = options[:release_version] || get_latest_release_before_version(
    repo_name: REPO_NAME,
    version: local_version
  )
  api_key = ENV["MAESTRO_TEST_STORE_API_KEY"]
  UI.user_error!("MAESTRO_TEST_STORE_API_KEY must contain a Test Store key") unless api_key&.start_with?("test_")

  FileUtils.rm_rf(output_dir)
  { "release" => release_version, "local" => local_version }.each do |name, sdk_version|
    variant_dir = "#{output_dir}/#{name}"
    FileUtils.mkdir_p(variant_dir)
    platform_task = platform == "ios" ? "linkDebugFrameworkIosSimulatorArm64" : "assembleDebug"
    dependency_task = platform == "ios" ? "verifySdkUpdateIosDependency" : "verifySdkUpdateAndroidDependency"
    gradle(
      tasks: [":e2e-tests:SDKUpdateTester:#{dependency_task}", ":e2e-tests:SDKUpdateTester:#{platform_task}"],
      project_dir: base_path,
      properties: name == "release" ? { "SDK_UPDATE_TESTER_RELEASE_VERSION" => sdk_version } : {},
      flags: "--no-configuration-cache --max-workers=2"
    )
    report = "#{project_dir}/build/#{name}/reports/resolved-dependencies/#{platform == 'ios' ? 'Ios' : 'Android'}.txt"
    FileUtils.cp(report, "#{variant_dir}/resolved-dependencies.txt")
    if platform == "ios"
      log_path = "#{variant_dir}/xcodebuild.log"
      pid = Process.spawn(
        "xcodebuild", "build",
        "-project", "#{project_dir}/iosApp/SDKUpdateTester.xcodeproj",
        "-scheme", "SDKUpdateTester",
        "-configuration", "Debug",
        "-destination", "generic/platform=iOS Simulator",
        "-derivedDataPath", "#{variant_dir}/derived_data",
        "SDK_UPDATE_TESTER_FRAMEWORK_DIR=#{project_dir}/build/#{name}/bin/iosSimulatorArm64/debugFramework",
        "ARCHS=arm64", "CODE_SIGNING_ALLOWED=NO",
        out: log_path, err: [:child, :out]
      )
      _, status = Process.wait2(pid)
      unless status.success?
        UI.error(File.readlines(log_path).last(50).join)
        UI.user_error!("#{name} iOS build failed. See #{log_path}")
      end
      FileUtils.cp_r("#{variant_dir}/derived_data/Build/Products/Debug-iphonesimulator/SDKUpdateTester.app", variant_dir)
    else
      FileUtils.cp("#{project_dir}/build/#{name}/outputs/apk/debug/SDKUpdateTester-debug.apk", "#{variant_dir}/SDKUpdateTester.apk")
    end
    File.write("#{variant_dir}/version.txt", sdk_version)
  end
  UI.success("SDK update test apps available in #{output_dir}")
end

desc "Run a KMP SDK update Maestro test case"
lane :run_sdk_update_test do |options|
  platform = sdk_update_test_platform(options)
  test_case = options[:test_case]
  unless %w[anonymous_user logged_in_user].include?(test_case)
    UI.user_error!("test_case must be anonymous_user or logged_in_user")
  end
  base_path = File.expand_path("..", Dir.pwd)
  apps_dir = File.expand_path(options[:apps_dir] || "build/sdk_update_tests/#{platform}", base_path)
  flows_dir = "#{base_path}/e2e-tests/maestro/sdk_update_tests/#{test_case}"
  app = lambda do |name|
    version_path = "#{apps_dir}/#{name}/version.txt"
    UI.user_error!("#{version_path} not found. Run build_sdk_update_test_apps first.") unless File.exist?(version_path)
    extension = platform == "ios" ? "app" : "apk"
    { app_path: "#{apps_dir}/#{name}/SDKUpdateTester.#{extension}", sdk_version: File.read(version_path).strip }
  end
  run_sdk_update_maestro_test(
    platform: platform,
    app_id: "com.revenuecat.SDKUpdateTester",
    steps: [
      app.call("release").merge(flow: "#{flows_dir}/before_update.yaml"),
      app.call("local").merge(flow: "#{flows_dir}/after_update.yaml")
    ],
    output_dir: File.expand_path(options[:output_dir] || "fastlane/test_output/sdk_update_tests/#{platform}/#{test_case}", base_path),
    max_attempts: Integer(options.fetch(:max_attempts, 3))
  )
end

def sdk_update_test_platform(options)
  platform = options[:platform]
  UI.user_error!("platform must be ios or android") unless %w[ios android].include?(platform)
  platform
end

def current_version_number
  File.read("../gradle/libs.versions.toml")
    .match('revenuecat-kmp = "(.*)"')
    .captures[0]
end

def get_android_version
  version = File.read("../gradle/libs.versions.toml")
    .match('revenuecat-android = "(.*)"')
    .captures[0]
  UI.user_error!("Android version not found in libs.versions.toml") if version.nil?
  version
end

def get_ios_version
  local_path = "../upstream/purchases-ios/.version"
  if File.exist?(local_path)
    version = File.read(local_path).strip
    return version unless version.empty?
  end

  require 'base64'
  submodule_sha = `git -C .. ls-tree HEAD upstream/purchases-ios`.split[2]
  UI.user_error!("Could not read upstream/purchases-ios submodule commit from the parent tree") if submodule_sha.nil? || submodule_sha.empty?
  response = github_api(
    server_url: 'https://api.github.com',
    api_token: ENV["GITHUB_TOKEN"],
    http_method: 'GET',
    path: "/repos/RevenueCat/purchases-ios/contents/.version?ref=#{submodule_sha}"
  )
  version = Base64.decode64(response[:json]['content']).strip
  UI.user_error!("iOS version not found in upstream/purchases-ios/.version at #{submodule_sha}") if version.nil? || version.empty?
  version
end

def get_billing_client_version(android_version)
  require 'base64'
  response = github_api(
    server_url: 'https://api.github.com',
    api_token: ENV["GITHUB_TOKEN"],
    http_method: 'GET',
    path: "/repos/RevenueCat/purchases-android/contents/gradle/libs.versions.toml?ref=#{android_version}"
  )
  contents = Base64.decode64(response[:json]['content'])
  matches = contents.match('bc8 = "(.*)"')
  UI.user_error!("Could not find Play Billing Library version for purchases-android #{android_version}") unless matches
  matches.captures[0]
end

def update_versions_file(sdk_version)
  android_version = get_android_version
  ios_version = get_ios_version
  billing_version = get_billing_client_version(android_version)

  UI.message("Android version: #{android_version}")
  UI.message("iOS version: #{ios_version}")
  UI.message("Play Billing Library version: #{billing_version}")

  versions_path = File.join('..', PATH_VERSIONS)
  lines = File.readlines(versions_path)
  new_line = [
    sdk_version,
    "[#{ios_version}](https://github.com/RevenueCat/purchases-ios/releases/tag/#{ios_version})",
    "[#{android_version}](https://github.com/RevenueCat/purchases-android/releases/tag/#{android_version})",
    "N/A",
    "[#{billing_version}](https://developer.android.com/google/play/billing/release-notes)"
  ].join(' | ')
  lines.insert(2, "| #{new_line} |\n")
  File.write(versions_path, lines.join)
end

def check_no_git_tag_exists(version_number)
  if git_tag_exists(tag: version_number, remote: true, remote_name: 'origin')
    raise "git tag with version #{version_number} already exists!"
  end
end

# Publishes the SDK. If the current version is a SNAPSHOT version, it will be published
# to Sonatype's snapshots repository, otherwise it will be published to Maven Central.
#
# This requires the following environment variables to be set:
# - MAVEN_CENTRAL_PORTAL_USERNAME
# - MAVEN_CENTRAL_PORTAL_PASSWORD
# - SIGNING_GPG_IN_MEMORY
# - GPG_SIGNING_KEY_PW_NEW
#
# These are set on CircleCI by providing the maven-central-publishing context when
# running the publish job.
def publish
  version = current_version_number
  UI.verbose("Publishing #{version}")
  ENV["ORG_GRADLE_PROJECT_mavenCentralUsername"] = ENV["MAVEN_CENTRAL_PORTAL_USERNAME"]
  ENV["ORG_GRADLE_PROJECT_mavenCentralPassword"] = ENV["MAVEN_CENTRAL_PORTAL_PASSWORD"]
  ENV["ORG_GRADLE_PROJECT_signingInMemoryKey"] = ENV["SIGNING_GPG_IN_MEMORY"]
  ENV["ORG_GRADLE_PROJECT_signingInMemoryKeyPassword"] = ENV["GPG_SIGNING_KEY_PW_NEW"]
  # Sonatype has a tendency to timeout. Default is 1 minute. This sets it to 5.
  # https://vanniktech.github.io/gradle-maven-publish-plugin/central/#timeouts
  ENV["SONATYPE_CONNECT_TIMEOUT_SECONDS"] = "300"
  gradle(
    task: "publishAllPublicationsToMavenCentralRepository",
    flags: "--no-configuration-cache"
  )
end
